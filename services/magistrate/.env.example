# Railway worker service "marginalia-magistrate" (separate from the web app). Fill every value; never commit real ones.
# Start command: node services/magistrate/index.js   (services/magistrate/railway.json)

# --- identity: a DEDICATED hot key, never the deployer. Fund it with ~0.001 ETH on chain 46630.
# It must be the register's current Magistrate (rotate with scripts/governance/rotate-magistrate.js).
MAGISTRATE_PUBLISHER_KEY=

# --- chain: comma separated lists fall back automatically. The logs RPC needs a generous eth_getLogs range.
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_LOGS_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_LOG_CHUNK=5000000

# --- state in Supabase (run supabase/migrations/20261009000000_phase3_magistrate.sql once; check: node scripts/supabase-check.js)
MAGISTRATE_STORE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- IPFS: two different providers (the worker alarms if only one pinned)
PINATA_JWT=
IPFS_RPC_URL=https://rpc.filebase.io
IPFS_RPC_AUTH=Bearer <filebase IPFS RPC key>

# --- screening (any DENY wins; an outage stops publication)
CHAINALYSIS_API_KEY=
DENYLIST=
# DENYLIST_URL=

# --- operations
ALERT_WEBHOOK_URL=
MAGISTRATE_MIN_INTERVAL_MIN=15
MAGISTRATE_HEALTH_PORT=8081
