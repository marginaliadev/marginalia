# Deployer / signer key (TESTNET ONLY - never commit a real key)
DEPLOYER_PRIVATE_KEY=0x...

# Robinhood Chain testnet (chainId 46630). Public RPC works; Alchemy is recommended.
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
# RH_TESTNET_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/<API_KEY>

# Mainnet (chainId 4663) - DO NOT deploy the prototype here
RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Address allowed to publish ASP roots (defaults to deployer)
MAGISTRATE_ADDRESS=

# Set to 1 to compile with the bundled solc-js instead of downloading native solc
USE_SOLCJS=

# ------------------------------------------------------------------
# Supabase Database Configuration
# ------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...
SUPABASE_ANON_KEY=ey...

# API Server Port
PORT=3000

