# --- Chain / contracts (defaults point at the Robinhood Chain Testnet deployment) ---
RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
MARGINALIA_POOL_ADDRESS=
MAGISTRATE_REGISTER_ADDRESS=
POOL_DEPLOY_BLOCK=129140787

# --- Folio index (optional but strongly recommended) ---
# Free-tier RPCs cap eth_getLogs at 10 blocks. The index (Supabase folio_leaves) keeps /api/folio fast; the
# service-role key lets the server persist new leaves. Without it, leaves live in memory until restart.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used only to fill gaps in the index from chain logs, on an RPC that allows large ranges:
RH_LOGS_RPC_URL=
RH_LOG_CHUNK=10

# --- Mersenne Courier (gasless relayer). Without it the UI only offers wallet-submitted withdrawals. ---
RELAYER_PRIVATE_KEY=

# --- Approved-label (ASP) list published by the Magistrate (default: ../asp/robinhoodTestnet.labels.json) ---
ASP_LABELS_FILE=
