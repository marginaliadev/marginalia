# MAINNET environment template. Never commit real values. Fill ONLY after `node scripts/mainnet-preflight.js` says GO.
# Each block is for one Railway service. Keys are never shared between services and never reused from testnet.

# ---------------------------------------------------------------- deploy machine (one-off, not a service)
# RH_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# DEPLOYER_PRIVATE_KEY=            # fresh key, hardware wallet or clean machine; different from every Safe owner and the publisher
# MAGISTRATE_ADDRESS=              # the PUBLISHER address (never the deployer)
# CEREMONY_WITHDRAW_TRANSCRIPT=ceremony/withdraw/transcript.json
# CEREMONY_RAGEQUIT_TRANSCRIPT=ceremony/ragequit/transcript.json

# ---------------------------------------------------------------- web service
# NEXT_PUBLIC_CHAIN=mainnet                          (selects chain 4663 in frontend/src/lib/chain.ts; any other value = testnet)
# RH_MAINNET_RPC_URL=https://<paid rpc>,https://robinhood-rpc.publicnode.com     # comma separated = automatic fallback; the public RPC is appended
# NEXT_PUBLIC_MARGINALIA_POOL_ADDRESS=               # REQUIRED on mainnet (no default)
# NEXT_PUBLIC_MAGISTRATE_REGISTER_ADDRESS=           # REQUIRED on mainnet (no default)
# NEXT_PUBLIC_POOL_DEPLOY_BLOCK=                     # REQUIRED on mainnet (block of the pool deployment)
# RH_LOGS_RPC_URL=https://robinhood-rpc.publicnode.com                            # large eth_getLogs range
# MARGINALIA_POOL_ADDRESS=                           # server-side override of the pool (optional, same value as above)
# MAGISTRATE_REGISTER_ADDRESS=
# POOL_DEPLOY_BLOCK=
# RELAYER_PRIVATE_KEY=                               # its own funded wallet, alert at 0.0005 ETH
# RELAYER_MIN_BALANCE_ETH=0.0005
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# ASP_IPFS_GATEWAYS=https://gateway.pinata.cloud/ipfs/,https://ipfs.io/ipfs/,https://dweb.link/ipfs/
# (leave ASP_LABELS_URL unset: lists come from IPFS first)

# ---------------------------------------------------------------- Magistrate worker service (own service, own key)
# MAGISTRATE_PUBLISHER_KEY=                          # mainnet-only key, funded about 0.001 ETH, registered as Magistrate
# MAGISTRATE_STORE=supabase
# DEPLOYMENT_FILE=deployments/robinhood.json
# RH_TESTNET_RPC_URL=                                # the worker reads this name for its main RPC: set it to the MAINNET RPC list
# RH_LOGS_RPC_URL=https://robinhood-rpc.publicnode.com
# RH_LOG_CHUNK=5000000
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# PINATA_JWT=
# IPFS_RPC_URL=https://rpc.filebase.io
# IPFS_RPC_AUTH=Bearer <filebase key>
# CHAINALYSIS_API_KEY=                               # plus a paid provider before mainnet (R5)
# DENYLIST=
# ALERT_WEBHOOK_URL=
# MAGISTRATE_MIN_INTERVAL_MIN=15
# NIXPACKS_NODE_VERSION=22

# ---------------------------------------------------------------- operator machine (preflight and monitoring)
# MAINNET_RPC=
# MAINNET_SAFE=
# MAINNET_PUBLISHER=
# MAINNET_DEPLOYER=

# ================================================================ 0xbow route (docs/bow_mainnet_runbook.md). Comments only; fill on the operator machine / Railway.
# ---------------------------------------------------------------- deploy and checks (operator machine, never a service)
# MAINNET_RPC=https://<paid rpc>,https://robinhood-rpc.publicnode.com
# MAINNET_SAFE=                 # >= 3 hardware-wallet owners, threshold >= 2
# MAINNET_PUBLISHER=            # dedicated postman key address (never the deployer)
# MAINNET_DEPLOYER=             # address of the key below; funded >= MIN_DEPLOYER_ETH (default 0.05); not a Safe owner
# MAINNET_DEPLOYER_PRIVATE_KEY= # fresh key; a testnet key is never accepted by deploy.js --network mainnet
# CONFIRM=deploy-bow-mainnet    # set by the owner ONLY for the real deploy; without it the script is a dry run
# ---------------------------------------------------------------- web service additions
# BOW_ENTRYPOINT=               # Entrypoint proxy address from deployments/bow-robinhood.json (the bow routes answer 503 without it)
# NEXT_PUBLIC_BOW_ENTRYPOINT=   # same value, for the /pool page
# NEXT_PUBLIC_BOW_POOL=         # PrivacyPoolSimple_ETH address
# NEXT_PUBLIC_BOW_DEPLOY_BLOCK= # block of the first contract in the record (start of the log scan)
# ---------------------------------------------------------------- Magistrate worker additions
# BOW_ENTRYPOINT=               # the worker publishes through Entrypoint.updateRoot (services/magistrate/bow-target.js)
# BOW_POOL=
